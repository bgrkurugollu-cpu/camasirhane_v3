# --- Veritabanı ---
POSTGRES_USER=camasirhane
POSTGRES_PASSWORD=changeme
POSTGRES_DB=camasirhane_db
DATABASE_URL=postgresql://camasirhane:changeme@db:5432/camasirhane_db

# --- Kimlik Doğrulama (JWT RS256 — ADR 0001) ---
# JWT imzalama asimetrik RS256 ile yapılır; HS256/SECRET_KEY KULLANILMAZ.
# Anahtar üret: openssl genrsa -out certs/private_key.pem 2048
#               openssl rsa -in certs/private_key.pem -pubout -out certs/public_key.pem
PRIVATE_KEY_PATH=certs/private_key.pem
PUBLIC_KEY_PATH=certs/public_key.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin MFA (TOTP — ADR 0007) ---
MFA_ISSUER=LaundroStar
MFA_TOKEN_EXPIRE_MINUTES=5
# true: MFA tanımlamamış admin login yanıtında zorunlu kayıt uyarısı alır
ADMIN_MFA_REQUIRED=false

# --- Ağ / Güvenlik ---
# İzinli origin listesi (virgülle ayır). Wildcard "*" YASAK.
CORS_ORIGINS=https://laundrostar.example.com
# Swagger/ReDoc varsayılan kapalı. Geliştirmede açmak için yorumları kaldır:
# DOCS_URL=/docs
# REDOC_URL=/redoc

# --- Diğer ---
TZ=Europe/Istanbul
# Testlerde gerçek Postgres kullanmak için (boşsa sqlite'a düşer):
# TEST_DATABASE_URL=postgresql://camasirhane:changeme@localhost:5432/camasirhane_test
